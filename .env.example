# ---------------------------------------------------------------------
# CloudVaultX configuration
# Copy to .env and adjust before running. Generate real secrets with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------

# --- Environment -----------------------------------------------------
# "production" refuses to start without an explicit MASTER_KEY; use
# "development" for local work.
ENVIRONMENT=development

# --- Security --------------------------------------------------------
# 32-byte AES-256 master key, base64 encoded. All file keys derive from it.
MASTER_KEY=
# Secret used to sign JWT access tokens (>= 32 characters).
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
# Shared token the coordinator uses to authenticate against storage nodes.
NODE_TOKEN=dev-node-token

# --- Database --------------------------------------------------------
# Used by docker compose (PostgreSQL). Local dev defaults to SQLite.
DATABASE_URL=postgresql+psycopg://cloudvaultx:cloudvaultx@postgres:5432/cloudvaultx

# --- Storage nodes ---------------------------------------------------
# Comma separated base URLs of the storage node containers.
NODE_URLS=http://node1:9000,http://node2:9000,http://node3:9000,http://node4:9000
NODE_CAPACITY_BYTES=1073741824

# --- Storage behaviour ----------------------------------------------
CHUNK_SIZE_BYTES=262144
REPLICATION_FACTOR=3

# --- Administration --------------------------------------------------
# Comma separated emails granted administrator rights (node management,
# model retraining, repairs). The first account registered on a fresh
# deployment is promoted automatically.
ADMIN_EMAILS=

# --- Monitoring & ML -------------------------------------------------
MONITOR_ENABLED=true
NODE_POLL_INTERVAL_SECONDS=10
NODE_OFFLINE_AFTER_FAILURES=2
AUTO_REPAIR_ENABLED=true
# Trim surplus replicas once every node is healthy again.
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SECONDS=60
MODEL_PATH=./data/model/node_selector.joblib
AUTO_TRAIN_MODEL=true
ML_WEIGHT=0.7

# --- Frontend --------------------------------------------------------
# Port the web UI is published on.
FRONTEND_PORT=5173
